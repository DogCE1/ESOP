<!--Deliverable 3: Whole file-->
@model ESOP.Models.StaffIndexViewModel

@{
   ViewData["Title"] = "Staff Management";

   //Helpers for the sortable column headers
   //Clicking the column already sorted ascending flips it to descending, any other column starts ascending
   string NextDir(string column) => Model.Sort == column && !Model.Descending ? "desc" : "asc";
   string Arrow(string column) => Model.Sort != column ? "" : Model.Descending ? " ▼" : " ▲";
   string AriaSort(string column) => Model.Sort != column ? "none" : Model.Descending ? "descending" : "ascending"; //Tells screen readers how the table is sorted
   var currentDir = Model.Descending ? "desc" : "asc";
}

<!--These are the feedback messages, whether success or error. Gets feedback from controller after redirect-->
<!--Error Messages-->
@{
   if (TempData["EMessage"] != null)
   {
      <div class="alert alert-danger">@TempData["EMessage"]</div>
   } 
}

<!--Success Messages-->
@{
   if (TempData["SMessage"] != null)
   {
      <div class="alert alert-success">@TempData["SMessage"]</div>
   }
}

<!-- Layout of displayed data-->
<div class="container mt-5">
   <div class="row mb-4">
      <div class="col-md-8">
         <h2>Staff Management</h2>
      </div>
      <div class="col-md-4 text-end">
         <!--Button to create new staff member-->
         <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#createModal">
            Add new staff
         </button>
         
         <!--Logout-->
         <form method="post" asp-controller="Access" asp-action="Logout" class="d-inline"> <!--Posts to AccessController.Logout, the tag helper also adds the anti-forgery token-->
         <button type="submit" class="btn btn-danger">Logout</button>
         </form>
      </div>
   </div>

   @if (Model.TotalCount == 0)
   {
      <div class="alert alert-info">No staff members found. Click "Add new staff" to create one.</div>
   }
   else
   {
      <!--Search: a GET form, so the search ends up in the URL (?search=...) and the page can be refreshed or bookmarked-->
      <form method="get" asp-action="Index" class="row g-2 mb-3" role="search">
         <!--Keep the current sort while searching-->
         <input type="hidden" name="sort" value="@Model.Sort"/>
         <input type="hidden" name="dir" value="@currentDir"/>
         <div class="col-sm-8 col-md-6">
            <input type="search" name="search" value="@Model.Search" class="form-control"
                   placeholder="Search by ID, name, email, position or unit" aria-label="Search staff"/>
         </div>
         <div class="col-auto">
            <button type="submit" class="btn btn-primary">Search</button>
            @if (Model.Search != null)
            {
               <a asp-action="Index" asp-route-sort="@Model.Sort" asp-route-dir="@currentDir" class="btn btn-outline-secondary">Clear</a>
            }
         </div>
      </form>

      @if (Model.Search != null && Model.Staff.Count > 0)
      {
         <p class="text-muted">Showing @Model.Staff.Count of @Model.TotalCount staff members matching "@Model.Search".</p>
      }
   }

   @if (Model.TotalCount > 0 && Model.Staff.Count == 0)
   {
      <div class="alert alert-warning">No staff members match "@Model.Search".</div>
   }
   else if (Model.Staff.Count > 0)
   {
      <table class="table table-striped table-hover">
         <thead class="table-dark">
         <tr> <!--Table headers: click one to sort by that column, click again to reverse. The current search is kept-->
            <th aria-sort="@AriaSort("id")"><a class="text-white text-decoration-none" asp-action="Index" asp-route-search="@Model.Search" asp-route-sort="id" asp-route-dir="@NextDir("id")">ID@(Arrow("id"))</a></th>
            <th aria-sort="@AriaSort("name")"><a class="text-white text-decoration-none" asp-action="Index" asp-route-search="@Model.Search" asp-route-sort="name" asp-route-dir="@NextDir("name")">Full Name@(Arrow("name"))</a></th>
            <th aria-sort="@AriaSort("email")"><a class="text-white text-decoration-none" asp-action="Index" asp-route-search="@Model.Search" asp-route-sort="email" asp-route-dir="@NextDir("email")">Email@(Arrow("email"))</a></th>
            <th aria-sort="@AriaSort("position")"><a class="text-white text-decoration-none" asp-action="Index" asp-route-search="@Model.Search" asp-route-sort="position" asp-route-dir="@NextDir("position")">Position@(Arrow("position"))</a></th>
            <th aria-sort="@AriaSort("unit")"><a class="text-white text-decoration-none" asp-action="Index" asp-route-search="@Model.Search" asp-route-sort="unit" asp-route-dir="@NextDir("unit")">Unit@(Arrow("unit"))</a></th>
            <th>Actions</th>
         </tr>
         </thead>
         <tbody>
         @foreach (var staff in Model.Staff)
         {
            <tr><!--One row per staff member-->
               <td>@staff.StaffId</td>
               <td>@staff.FullName</td>
               <td>@staff.Email</td>
               <td>@staff.Position</td>
               <td>@staff.Unit</td>
               <td> <!--Buttons to edit and delete a staff member-->
                  <!--Values go in data-* attributes (HTML-encoded by Razor) instead of inline JS strings, so names like O'Brien can't break or inject script-->
                  <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#editModal"
                          data-id="@staff.StaffId" data-fullname="@staff.FullName" data-email="@staff.Email" data-position="@staff.Position" data-unit="@staff.Unit"
                          onclick="populateEditForm(this)">
                     Edit
                  </button>
                  <button type="button" class="btn btn-sm btn-danger" data-bs-toggle="modal" data-bs-target="#deleteModal" onclick="setDeleteId(@staff.StaffId)">
                     Delete
                  </button>
               </td>
            </tr>
         }
         </tbody>
      </table>
   }
</div>

<!--Create Modal: Displays a form for creating a new staff member-->
<div class="modal fade" id="createModal" tabindex="-1">
   <div class="modal-dialog">
      <div class="modal-content">
         <div class="modal-header">
            <h5 class="modal-title">Add new staff member</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
         </div>
         <form method="post" asp-controller="Staff" asp-action="Create"> <!--Posts to StaffController.Create, the tag helper also adds the anti-forgery token-->
            <div class="modal-body">
               <!--Full Name field-->
               <div class="mb-3">
                  <label for="fullName" class="form-label">Full Name</label>
                  <input type="text" class="form-control" id="fullName" name="fullName" required/>
               </div>
               <!--Email field-->
               <div class="mb-3">
                  <label for="email" class="form-label">Email</label>
                  <input type="email" class="form-control" id="email" name="email" required/>
               </div>
               <!--Position Field-->
               <div class="mb-3">
                  <label for="position" class="form-label">Position</label>
                  <input type="text" class="form-control" id="position" name="position" required/>
               </div>
               <!--Unit field-->
               <div class="mb-3">
                  <label for="unit" class="form-label">Unit</label>
                  <input type="text" class="form-control" id="unit" name="unit" required/>
               </div>
            </div>
            <!--Footer of modal form-->
            <div class="modal-footer">
               <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
               <button type="submit" class="btn btn-success">Create</button>
            </div>
         </form>
      </div>
   </div>
</div>

<!--Edit Modal + populateEditForm: Displays a form for editing the currently selected user, with all of the users data pre-filled-->
<div class="modal fade" id="editModal" tabindex="-1">
   <div class="modal-dialog">
      <div class="modal-content">
         <div class="modal-header">
            <h5 class="modal-title">Edit staff member</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
         </div>
         <form method="post" asp-controller="Staff" asp-action="Edit"> <!--Posts to StaffController.Edit, the tag helper also adds the anti-forgery token-->
            <div class="modal-body">
               <input type="hidden" id="edtStaffId" name="staffId"/>
               
               <!--Full Name field-->
               <div class="mb-3">
                  <label for="edtFullName" class="form-label">Full Name</label>
                  <input type="text" class="form-control" id="edtFullName" name="fullName" required/>
               </div>
               
               <!--Email field-->
               <div class="mb-3">
                  <label for="edtEmail" class="form-label">Email</label>
                  <input type="email" class="form-control" id="edtEmail" name="email" required/>
               </div>
               
               <!--Position Field-->
               <div class="mb-3">
                  <label for="edtPosition" class="form-label">Position</label>
                  <input type="text" class="form-control" id="edtPosition" name="position" required/>
               </div>
               <!--Unit field-->
               <div class="mb-3">
                  <label for="edtUnit" class="form-label">Unit</label>
                  <input type="text" class="form-control" id="edtUnit" name="unit" required/>
               </div>
            </div>
            <!--Footer of modal form-->
            <div class="modal-footer">
               <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
               <button type="submit" class="btn btn-success">Update</button>
            </div>
         </form>
      </div>
   </div>
</div>

<!--Delete Modal + setDeleteId: stores which staff member to delete before the confirm form is submitted-->
<div class="modal fade" id="deleteModal" tabindex="-1">
   <div class="modal-dialog">
      <div class="modal-content">
         <div class="modal-header">
            <h5 class="modal-title">Delete staff member</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
         </div>
         <div class="modal-body">
            Are you sure you want to delete this staff member?
         </div>
         <form method="post" asp-controller="Staff" asp-action="Delete" id="deleteForm"> <!--Posts to StaffController.Delete, the tag helper also adds the anti-forgery token-->
            <input type="hidden" id="deleteStaffId" name="id"/>
            <div class="modal-footer">
               <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
               <button type="submit" class="btn btn-danger">Delete</button>
            </div>
         </form>
      </div>
   </div>
</div>

<script>
  function populateEditForm(button){
     const staff = button.dataset;
     document.getElementById('edtStaffId').value = staff.id;
     document.getElementById('edtFullName').value = staff.fullname;
     document.getElementById('edtEmail').value = staff.email;
     document.getElementById('edtPosition').value = staff.position;
     document.getElementById('edtUnit').value = staff.unit;
  }
  function setDeleteId(id){
     document.getElementById('deleteStaffId').value = id;
  }
</script>